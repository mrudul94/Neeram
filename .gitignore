# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/data/
!.env.example
*.log
logs/

# OS files
Thumbs.db
desktop.ini

# python
.venv/
__pycache__/
*.py[cod]

# bottle renders: keep only the WebP frames the site serves
public/bottle/_matched/
public/bottle/**/*.png

# Figma board export (44 MB, kept on disk only)
design/NEERAM___E-commerce_Website.png

# blender backups
*.blend1

# claude code personal settings (graphify hooks with machine paths)
.claude/settings.local.json

# graphify (machine-local)
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_build_state.json
graphify-out/.graphify_labels.pending.json
graphify-out/20??-??-??/


# playwright
/test-results/
/playwright-report/
/blob-report/

# Google service account keys: keep them out of the project (see docs/ORDER_SHEET_SETUP.md)
*service-account*.json
*serviceaccount*.json
*credentials*.json

# Cloudflare (OpenNext build output, wrangler state, local secrets)
/.open-next/
/.wrangler/
.dev.vars*
!.dev.vars.example
