# Public, not a secret: built into every page. Never put secrets in this committed file.
# Change it when the site moves to its real domain.
NEXT_PUBLIC_SITE_URL=https://neeram.in

# Search engines may index the site: pages drop their noindex tag and the sitemap lists every page.
# Read at build time. Checkout stays noindex on its own. Remove (or set to 0) to hide the site again.
SITE_LIVE=1
