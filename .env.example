# Public URL of the site (canonical links, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (public). Read at BUILD time, so it must be set wherever
# `npm run deploy` (or Workers Builds) builds the site. Empty: no widget, check skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Secrets: set on the Cloudflare Worker (dashboard → Variables and Secrets, type
# Secret, or `npx wrangler secret put NAME`), never in a committed file. For the local
# Cloudflare preview, put them in .dev.vars (see .dev.vars.example). ---

# Turnstile secret key, paired with the site key above.
TURNSTILE_SECRET_KEY=

# Google Sheet that receives orders and sign-ups (see docs/ORDER_SHEET_SETUP.md). Until all
# three are set, records are logged to Workers Logs tagged "… NOT SAVED TO SHEET".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# --- Tests only (set by playwright.config.ts) ---
# ORDERS_TEST_MODE=1 keeps records off the sheet and in data/<file>.jsonl;
# STORE_JSON_SUFFIX=test names that file data/<file>.test.jsonl.
