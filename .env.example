# Public URL of the site (canonical links, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheet that receives orders (see docs/ORDER_SHEET_SETUP.md).
# Set these in Vercel, never in a committed file. Until all three are set, orders are
# logged to the server console tagged "… NOT SAVED TO SHEET".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
